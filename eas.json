{
	"cli": {
		"version": ">= 18.0.6",
		"appVersionSource": "remote"
	},
	"build": {
		"preview": {
			"autoIncrement": true,
			"developmentClient": false,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"APP_VARIANT": "preview"
			}
		},
		"production": {
			"distribution": "store",
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "production"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
